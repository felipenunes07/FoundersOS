# ---------------------------------------------------------------------------
# Formulário de interesse na turma (api/interesse.js)
#
# Em produção estas variáveis vivem em:
#   Vercel › Project FoundersOS › Settings › Environment Variables
# Localmente, copie este arquivo para `.env` (que já está no .gitignore).
# ---------------------------------------------------------------------------

# >>> COLOQUE AQUI O E-MAIL QUE DEVE RECEBER OS LEADS <<<
# Para onde vai a notificação de cada novo interesse. Aceita mais de um
# endereço, separados por vírgula. Sem isto, o lead é salvo mas ninguém é
# avisado por e-mail.
LEAD_NOTIFICATION_EMAIL=

# Chave da API do Resend (https://resend.com › API Keys). Sem ela o e-mail
# não é enviado — o lead ainda é gravado e registrado nos logs da função.
RESEND_API_KEY=

# Remetente da notificação. Precisa ser de um domínio verificado no Resend
# (ex.: "FoundersOS <turma@foundersos.com.br>"). Enquanto o domínio não
# estiver verificado, deixe vazio para usar o remetente de teste do Resend.
LEAD_FROM_EMAIL=

# Armazenamento dos leads (opcional, mas recomendado).
# Vercel › Storage › KV — ao conectar o store ao projeto, a Vercel injeta
# estas duas variáveis sozinha. Sem elas, o lead vai só para e-mail + logs.
KV_REST_API_URL=
KV_REST_API_TOKEN=
